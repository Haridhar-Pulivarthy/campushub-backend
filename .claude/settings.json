{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/dist/**)",
      "Read(**/dist-ssr/**)",
      "Read(**/build/**)",
      "Read(**/coverage/**)",
      "Read(**/package-lock.json)",
      "Read(**/npm-shrinkwrap.json)",
      "Read(**/yarn.lock)",
      "Read(**/pnpm-lock.yaml)",
      "Read(**/*.log)",
      "Read(**/logs/**)",
      "Read(**/*.map)",
      "Read(**/*.tsbuildinfo)"
    ]
  }
}
